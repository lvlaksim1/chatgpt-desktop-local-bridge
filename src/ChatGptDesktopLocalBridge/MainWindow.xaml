<Window x:Class="ChatGptDesktopLocalBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ChatGPT Desktop Local Bridge"
        Width="1440"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#151719"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#202124" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#222326" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#2A2C2F" />
        <SolidColorBrush x:Key="PanelInnerBrush" Color="#191A1D" />
        <SolidColorBrush x:Key="TopBarBrush" Color="#1C1D20" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#44464A" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#303236" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#303236" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3A3D41" />
        <SolidColorBrush x:Key="PanelTextBrush" Color="#F2F3F5" />
        <SolidColorBrush x:Key="PanelMutedBrush" Color="#A5A9AF" />

        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PanelTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PanelTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseWindowButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PanelMutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0,0,1,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource SelectedBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PanelTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderOnlyTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChatTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChatTabItemStyle}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="ChatGPT Desktop Local Bridge" />
                        <TextBlock x:Name="VersionText"
                                   Margin="10,0,0,0"
                                   Foreground="{DynamicResource PanelMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Text="v—" />
                        <TextBlock x:Name="StatusText"
                                   Margin="18,0,10,0"
                                   Foreground="{DynamicResource PanelMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="430"
                                   Text="Запуск…" />
                    </StackPanel>
                </Border>

                <Button x:Name="InitializeBridgeButton"
                        Grid.Column="1"
                        Margin="5,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="RefreshBridgeButton_OnClick"
                        Content="Мост" />
                <Button Grid.Column="2"
                        Margin="5,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="ReloadButton_OnClick"
                        Content="↻" />
                <Button Grid.Column="3"
                        Margin="5,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="NewChatButton_OnClick"
                        Content="+ Чат" />
                <Button Grid.Column="4"
                        Margin="5,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="SettingsButton_OnClick"
                        Content="Настройки" />
                <Button x:Name="UpdateButton"
                        Grid.Column="5"
                        Margin="5,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="UpdateButton_OnClick"
                        Visibility="Collapsed"
                        Content="Обновить" />
                <Button Grid.Column="6"
                        Margin="5,7,8,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="ScheduledTaskProbeButton_OnClick"
                        Content="Transport Probe" />
                <Button Grid.Column="7"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="MinimizeButton_OnClick"
                        Content="—" />
                <Button x:Name="MaximizeButton"
                        Grid.Column="8"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="MaximizeButton_OnClick"
                        Content="□" />
                <Button Grid.Column="9"
                        Style="{StaticResource CloseWindowButtonStyle}"
                        Click="CloseButton_OnClick"
                        Content="✕" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="BridgePanelColumn"
                                  Width="360"
                                  MinWidth="260"
                                  MaxWidth="760" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Background="{DynamicResource ShellBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TabControl x:Name="ChatTabs"
                            Grid.Row="0"
                            Style="{StaticResource HeaderOnlyTabControlStyle}"
                            SelectionChanged="ChatTabs_OnSelectionChanged" />

                <Grid x:Name="BrowserHost"
                      Grid.Row="1"
                      Background="{DynamicResource ShellBackgroundBrush}" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource PanelBorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Cursor="SizeWE" />

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,9,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PanelTextBrush}"
                                   Text="Local Bridge" />
                        <Button Grid.Column="1" Margin="5,0,0,0" Padding="8,4"
                                Click="StopLocalTaskButton_OnClick"
                                Content="STOP" />
                        <Button Grid.Column="2" Margin="5,0,0,0" Padding="8,4"
                                Click="ClearActivityButton_OnClick"
                                Content="Очистить события" />
                        <Button Grid.Column="3" Margin="5,0,0,0" Padding="8,4"
                                Click="ClearConsoleButton_OnClick"
                                Content="Очистить консоль" />
                    </Grid>

                    <TabControl Grid.Row="1"
                                Margin="8,0,8,8"
                                Style="{StaticResource PanelTabControlStyle}">
                        <TabItem Header="Активность">
                            <ListBox x:Name="ActivityList"
                                     BorderBrush="{DynamicResource PanelBorderBrush}"
                                     BorderThickness="1"
                                     Background="{DynamicResource PanelInnerBrush}"
                                     Foreground="{DynamicResource PanelTextBrush}"
                                     Padding="6"
                                     HorizontalContentAlignment="Stretch" />
                        </TabItem>
                        <TabItem Header="Консоль">
                            <TextBox x:Name="ConsoleTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     BorderBrush="{DynamicResource PanelBorderBrush}"
                                     BorderThickness="1"
                                     Padding="8"
                                     Background="{DynamicResource PanelInnerBrush}"
                                     Foreground="{DynamicResource PanelTextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="12" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>