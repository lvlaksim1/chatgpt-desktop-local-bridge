<Window x:Class="ChatGptDesktopLocalBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ChatGPT Desktop Local Bridge"
        Width="1440"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#151719"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#303236" />
            <Setter Property="BorderBrush" Value="#44474B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B3E42" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#242629" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35383C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseWindowButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1B1D1F" />
            <Setter Property="BorderBrush" Value="#34373A" />
            <Setter Property="Foreground" Value="#D8DADC" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#B8BBC0" />
            <Setter Property="Background" Value="#202225" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#34373A"
                                BorderThickness="0,0,1,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A2D30" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#303337" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8DADC" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid Background="#151719">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#202124"
                BorderBrush="#34373A"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid Margin="12,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="ChatGPT Desktop Local Bridge" />

                        <TextBlock x:Name="VersionText"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#979A9F"
                                   FontSize="12"
                                   Text="v—" />

                        <TextBlock x:Name="StatusText"
                                   Grid.Column="2"
                                   Margin="18,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="#A8ABB0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Запуск WebView2…" />
                    </Grid>
                </Border>

                <Button x:Name="InitializeBridgeButton"
                        Grid.Column="3"
                        Margin="6,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="InitializeBridgeButton_OnClick"
                        Content="Инициализировать мост" />

                <Button x:Name="ReloadButton"
                        Grid.Column="4"
                        Margin="6,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="ReloadButton_OnClick"
                        Content="Перезагрузить" />

                <Button x:Name="PermissionsButton"
                        Grid.Column="5"
                        Margin="6,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="PermissionsButton_OnClick"
                        Content="Разрешения" />

                <Button x:Name="DiagnosticsButton"
                        Grid.Column="6"
                        Margin="6,7,8,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="DiagnosticsButton_OnClick"
                        Content="Диагностика" />

                <Button Grid.Column="7"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="MinimizeButton_OnClick"
                        ToolTip="Свернуть"
                        Content="—" />

                <Button x:Name="MaximizeButton"
                        Grid.Column="8"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="MaximizeButton_OnClick"
                        ToolTip="Развернуть"
                        Content="□" />

                <Button Grid.Column="9"
                        Style="{StaticResource CloseWindowButtonStyle}"
                        Click="CloseButton_OnClick"
                        ToolTip="Закрыть"
                        Content="✕" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Background="#151719">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="360" MinWidth="260" MaxWidth="760" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#151719">
                <wv2:WebView2 x:Name="Browser" />
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#34373A"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Cursor="SizeWE" />

            <Border Grid.Column="2"
                    Background="#191B1D"
                    BorderBrush="#34373A"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="14,12,14,9"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#F1F1F1"
                               Text="Local Bridge" />

                    <TabControl Grid.Row="1"
                                Margin="8,0,8,8">
                        <TabItem Header="Активность">
                            <ListBox x:Name="ActivityList"
                                     BorderBrush="#34373A"
                                     BorderThickness="1"
                                     Background="#111315"
                                     Foreground="#D8DADC"
                                     Padding="6">
                                <ListBoxItem IsHitTestVisible="False">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#92969B"
                                               Text="Панель активности готова. События Local Bridge будут подключены на следующем этапе." />
                                </ListBoxItem>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Консоль">
                            <TextBox x:Name="ConsoleTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     BorderBrush="#34373A"
                                     BorderThickness="1"
                                     Padding="8"
                                     Background="#0F1113"
                                     Foreground="#E7E7E7"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Text="Консоль Local Bridge будет подключена на следующем этапе." />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
