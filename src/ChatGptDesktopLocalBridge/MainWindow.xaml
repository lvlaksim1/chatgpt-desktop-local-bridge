<Window x:Class="ChatGptDesktopLocalBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ChatGPT Desktop Local Bridge"
        Width="1280"
        Height="860"
        MinWidth="900"
        MinHeight="600">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="InitializeBridgeButton"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="InitializeBridgeButton_OnClick"
                        Content="Initialize Bridge" />

                <Button x:Name="ReloadButton"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="ReloadButton_OnClick"
                        Content="Reload" />

                <Button x:Name="PermissionsButton"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="PermissionsButton_OnClick"
                        Content="Permissions" />

                <Button x:Name="DiagnosticsButton"
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="DiagnosticsButton_OnClick"
                        Content="Diagnostics" />

                <Button x:Name="StopLocalTaskButton"
                        Grid.Column="4"
                        Margin="0,0,12,0"
                        Padding="12,6"
                        Click="StopLocalTaskButton_OnClick"
                        Content="STOP local task" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="5"
                           VerticalAlignment="Center"
                           Text="Starting WebView2…" />
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="Browser" />
    </DockPanel>
</Window>