<Window x:Class="ChatGptDesktopLocalBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ChatGPT Desktop Local Bridge"
        Width="1440"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#151719"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#151719" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#191B1D" />
        <SolidColorBrush x:Key="PanelInnerBrush" Color="#111315" />
        <SolidColorBrush x:Key="PanelTextBrush" Color="#E5E7E9" />
        <SolidColorBrush x:Key="PanelMutedBrush" Color="#92969B" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#34373A" />
        <SolidColorBrush x:Key="TabBackgroundBrush" Color="#202225" />
        <SolidColorBrush x:Key="TabSelectedBrush" Color="#2A2D30" />

        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#303236" />
            <Setter Property="BorderBrush" Value="#44474B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B3E42" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#242629" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35383C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseWindowButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PanelMutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0,0,1,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource TabSelectedBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PanelTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity"
                                        Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Background="{DynamicResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#202124"
                BorderBrush="#34373A"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="ChatGPT Desktop Local Bridge" />
                        <TextBlock x:Name="VersionText"
                                   Margin="10,0,0,0"
                                   Foreground="#979A9F"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Text="v—" />
                        <TextBlock x:Name="StatusText"
                                   Margin="18,0,10,0"
                                   Foreground="#A8ABB0"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="390"
                                   Text="Запуск…" />
                    </StackPanel>
                </Border>

                <Button x:Name="InitializeBridgeButton"
                        Grid.Column="1"
                        Margin="5,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="InitializeBridgeButton_OnClick"
                        Content="Мост" />

                <Button x:Name="ReloadButton"
                        Grid.Column="2"
                        Margin="5,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="ReloadButton_OnClick"
                        Content="↻" />

                <Button x:Name="NewChatButton"
                        Grid.Column="3"
                        Margin="5,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="NewChatButton_OnClick"
                        ToolTip="Новая вкладка ChatGPT"
                        Content="+ Чат" />

                <Button x:Name="SettingsButton"
                        Grid.Column="4"
                        Margin="5,7,0,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="SettingsButton_OnClick"
                        Content="Настройки" />

                <Button x:Name="UpdateButton"
                        Grid.Column="5"
                        Margin="5,7,8,7"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="UpdateButton_OnClick"
                        Visibility="Collapsed"
                        Content="Обновить" />

                <Button Grid.Column="6"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="MinimizeButton_OnClick"
                        ToolTip="Свернуть"
                        Content="—" />

                <Button x:Name="MaximizeButton"
                        Grid.Column="7"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="MaximizeButton_OnClick"
                        ToolTip="Развернуть"
                        Content="□" />

                <Button Grid.Column="8"
                        Style="{StaticResource CloseWindowButtonStyle}"
                        Click="CloseButton_OnClick"
                        ToolTip="Закрыть"
                        Content="✕" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Background="{DynamicResource ShellBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="BridgePanelColumn"
                                  Width="360"
                                  MinWidth="260"
                                  MaxWidth="760" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="ChatTabs"
                        Grid.Column="0"
                        Style="{StaticResource DarkTabControlStyle}"
                        SelectionChanged="ChatTabs_OnSelectionChanged" />

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource PanelBorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Cursor="SizeWE" />

            <Border x:Name="BridgePanel"
                    Grid.Column="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="12,9,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PanelTextBrush}"
                                   Text="Local Bridge" />
                        <Button Grid.Column="1"
                                Margin="5,0,0,0"
                                Padding="8,4"
                                Click="ClearActivityButton_OnClick"
                                Content="Очистить события" />
                        <Button Grid.Column="2"
                                Margin="5,0,0,0"
                                Padding="8,4"
                                Click="ClearConsoleButton_OnClick"
                                Content="Очистить консоль" />
                    </Grid>

                    <TabControl Grid.Row="1"
                                Margin="8,0,8,8"
                                Style="{StaticResource DarkTabControlStyle}">
                        <TabItem Header="Активность">
                            <ListBox x:Name="ActivityList"
                                     BorderBrush="{DynamicResource PanelBorderBrush}"
                                     BorderThickness="1"
                                     Background="{DynamicResource PanelInnerBrush}"
                                     Foreground="{DynamicResource PanelTextBrush}"
                                     Padding="6"
                                     HorizontalContentAlignment="Stretch" />
                        </TabItem>

                        <TabItem Header="Консоль">
                            <TextBox x:Name="ConsoleTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     BorderBrush="{DynamicResource PanelBorderBrush}"
                                     BorderThickness="1"
                                     Padding="8"
                                     Background="{DynamicResource PanelInnerBrush}"
                                     Foreground="{DynamicResource PanelTextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="12" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
