<Window x:Class="ChatGptDesktopLocalBridge.ScheduledTaskTransportProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled + Library Transport Probe"
        Width="1180"
        Height="860"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#181A1C"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10"
                Background="#202124"
                BorderBrush="#3A3D40"
                BorderThickness="1">
            <StackPanel>
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Text="Scheduled Tasks + ChatGPT Library Transport Probe · EXPERIMENTAL" />
                <TextBlock Margin="0,5,0,8"
                           Foreground="#AEB2B7"
                           TextWrapping="Wrap"
                           Text="Desktop-side transport research. Persistent log stores only sanitized endpoint metadata and JSON field/type shapes. Query values, bodies, cookies and auth headers are not persisted. Exact URL/body are kept in memory only so a human can replay the selected captured request through the same authenticated WebView2 session." />
                <WrapPanel>
                    <Button x:Name="CaptureButton"
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Click="CaptureButton_OnClick"
                            Content="Capture: OFF" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            Click="ClearButton_OnClick"
                            Content="Очистить" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            Click="OpenLogButton_OnClick"
                            Content="Открыть лог" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            Click="CopySelectedButton_OnClick"
                            Content="Копировать endpoint" />
                    <TextBlock x:Name="CaptureStatusText"
                               VerticalAlignment="Center"
                               Foreground="#AEB2B7"
                               Text="Ожидание" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,8,0,8"
                Padding="10"
                Background="#202124"
                BorderBrush="#3A3D40"
                BorderThickness="1">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="Маркеры действий для корреляции" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="TASK_OPEN" Click="MarkerButton_OnClick" Content="Task: Open" />
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="TASK_READ" Click="MarkerButton_OnClick" Content="Task: Read" />
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="TASK_EDIT" Click="MarkerButton_OnClick" Content="Task: Edit" />
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="TASK_PAUSE" Click="MarkerButton_OnClick" Content="Task: Pause" />
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="TASK_RESUME" Click="MarkerButton_OnClick" Content="Task: Resume" />
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="TASK_SCHEDULE" Click="MarkerButton_OnClick" Content="Task: Schedule" />
                    <Button Margin="10,0,6,6" Padding="9,4" Tag="LIB_LIST" Click="MarkerButton_OnClick" Content="Library: List/Search" />
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="LIB_CREATE" Click="MarkerButton_OnClick" Content="Library: Create" />
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="LIB_READ" Click="MarkerButton_OnClick" Content="Library: Read" />
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="LIB_REPLACE" Click="MarkerButton_OnClick" Content="Library: Replace" />
                    <Button Margin="0,0,6,6" Padding="9,4" Tag="LIB_DELETE" Click="MarkerButton_OnClick" Content="Library: Delete" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,8"
                Padding="10"
                Background="#202124"
                BorderBrush="#3A3D40"
                BorderThickness="1">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="Known endpoint hypotheses · read-only reproduction" />
                <TextBlock Margin="0,4,0,7"
                           Foreground="#AEB2B7"
                           TextWrapping="Wrap"
                           Text="Эти операции не угадывают mutation body. Они проверяют только read-only кандидаты из GitHub research через same-origin page-context fetch с document binding до/после запроса." />
                <WrapPanel>
                    <Button Margin="0,0,6,6" Padding="9,4"
                            Click="ProbeScheduledButton_OnClick"
                            Content="tasks.list scheduled" />
                    <Button Margin="0,0,6,6" Padding="9,4"
                            Click="ProbePausedButton_OnClick"
                            Content="tasks.list paused" />
                    <Button Margin="0,0,6,6" Padding="9,4"
                            Click="ProbeFinishedButton_OnClick"
                            Content="tasks.list finished" />
                    <TextBox x:Name="AutomationIdTextBox"
                             Width="220"
                             Margin="10,0,6,6"
                             Padding="6"
                             ToolTip="Automation ID для latest_backing_run" />
                    <Button Margin="0,0,16,6" Padding="9,4"
                            Click="ProbeLatestRunButton_OnClick"
                            Content="tasks.latest_run" />
                    <Button Margin="0,0,6,6" Padding="9,4"
                            Click="ProbeLibraryListButton_OnClick"
                            Content="library.list" />
                    <Button Margin="0,0,6,6" Padding="9,4"
                            Click="ProbeLibraryUsageButton_OnClick"
                            Content="library.storage" />
                    <Button Margin="10,0,6,6" Padding="9,4"
                            Click="SafeReadBackButton_OnClick"
                            Content="Safe read-back" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#111315"
                    BorderBrush="#3A3D40"
                    BorderThickness="1">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="8">
                        <TextBlock Margin="0,0,12,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="Backend candidates" />
                        <ComboBox x:Name="KindFilterComboBox"
                                  Width="150"
                                  SelectionChanged="KindFilterComboBox_OnSelectionChanged">
                            <ComboBoxItem IsSelected="True" Content="Все" Tag="ALL" />
                            <ComboBoxItem Content="Scheduled Tasks" Tag="TASKS" />
                            <ComboBoxItem Content="Library" Tag="LIBRARY" />
                        </ComboBox>
                    </WrapPanel>
                    <ListBox x:Name="TrafficList"
                             Margin="6,0,6,6"
                             Background="#111315"
                             Foreground="#E5E7EA"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="11"
                             DisplayMemberPath="Display"
                             SelectionChanged="TrafficList_OnSelectionChanged" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          Background="#34373A"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2"
                    Background="#111315"
                    BorderBrush="#3A3D40"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="8"
                               FontWeight="SemiBold"
                               Text="Selected request metadata / schema" />
                    <TextBox x:Name="DetailTextBox"
                             Margin="8,0,8,8"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="#111315"
                             Foreground="#E5E7EA"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="11" />
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Margin="0,8,0,8"
                Padding="10"
                Background="#202124"
                BorderBrush="#3A3D40"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Margin="0,0,8,6"
                           VerticalAlignment="Center"
                           Text="Expected marker" />
                <TextBox x:Name="ExpectedTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Margin="0,0,14,6"
                         Padding="6"
                         ToolTip="Optional text expected in the replay response. Only PASS/FAIL is shown; response body is not persisted." />

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Margin="0,0,8,6"
                           VerticalAlignment="Center"
                           Text="Method / endpoint" />
                <TextBox x:Name="ReplayEndpointTextBox"
                         Grid.Row="0" Grid.Column="3"
                         Margin="0,0,0,6"
                         Padding="6"
                         IsReadOnly="True" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,0,8,6"
                           VerticalAlignment="Top"
                           Text="Request body (memory only)" />
                <TextBox x:Name="ReplayBodyTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Height="105"
                         Margin="0,0,0,6"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11" />

                <WrapPanel Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="4">
                    <Button x:Name="ReplayButton"
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Click="ReplaySelectedButton_OnClick"
                            Content="Replay selected via page-context fetch" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#AEB2B7"
                               Text="GET/HEAD выполняются сразу; POST/PUT/PATCH/DELETE требуют отдельного подтверждения." />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Background="#111315"
                BorderBrush="#3A3D40"
                BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="8"
                           FontWeight="SemiBold"
                           Text="Page-context proof result" />
                <TextBox x:Name="ReplayResultTextBox"
                         Margin="8,0,8,8"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#111315"
                         Foreground="#E5E7EA"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="11" />
            </DockPanel>
        </Border>

        <Border Grid.Row="6"
                Margin="0,8,0,0"
                Padding="10"
                Background="#202124"
                BorderBrush="#3A3D40"
                BorderThickness="1">
            <TextBlock x:Name="OperationStatusText"
                       Foreground="#D9DDE2"
                       TextWrapping="Wrap"
                       Text="Статус: готово к Desktop-side Tasks + Library discovery и same-session replay. Production Local Bridge transport не изменён." />
        </Border>
    </Grid>
</Window>